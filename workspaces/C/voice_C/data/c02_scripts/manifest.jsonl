{"script_id": "tts-dev-01", "text": "我没有发热，也没有咳嗽。", "category": "negation", "text_sha256": "ed6aa0311524821871a3d3cdf83e569426a6635e01ccaaedef46174ee66bb3f6", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-02", "text": "我不是每天都头痛。今天没有胸痛。", "category": "negation", "text_sha256": "c533d0d08abdd921c5a9617c9097eca7a6b2d09f5dfafa41cc7dc026a4e88285", "sentence_count": 2, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-03", "text": "这份练习有12个问题。", "category": "number", "text_sha256": "077a4435cc8ecf512bd040f07934022d4bd1dd13ecf6a724c2be8355d60cbfb9", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-04", "text": "编号是103，人数是20人。", "category": "number", "text_sha256": "bfbed9d0ed9b14f9e8b1b68f8d8f576319f0e293e291ee93a069e77fe538c6d2", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-05", "text": "练习记录的数值是3.5。", "category": "decimal", "text_sha256": "0f01c49cb1ccab9c11641268a4dc34fc1686879eadef3c2864a2b34f58e62508", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-06", "text": "体温记录为37.2摄氏度。这里是虚构的录音练习。", "category": "decimal", "text_sha256": "654c0ec8d6a4a312a63d90725c619405a36a0a5a0b019eed6cb5c195e07e9141", "sentence_count": 2, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-07", "text": "练习从上午9点30分开始。", "category": "time", "text_sha256": "7a61e0ea4261227f542012cfd35990e83e9b8bf6992bc23667df6e9aec34f4e0", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-08", "text": "我昨天晚上头痛。今天早上已经不痛了。", "category": "time", "text_sha256": "c3771637c505e2728d6b408153939341156c9654633fb0e5b6291872f8091809", "sentence_count": 2, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-09", "text": "我感觉恶心，偶尔有心悸。", "category": "symptom", "text_sha256": "d442061eb2529c5a44796cb9892c7f2e219aa41607ac1d5c02e50e4eed89b67f", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-10", "text": "我有头晕，没有呼吸困难。", "category": "symptom", "text_sha256": "0c5c60af0c6ee12b785b24857eb6b7ef28a761f92e5db35c5bcdd94b70e5fea6", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-11", "text": "这是关于支气管炎的发音练习。", "category": "term", "text_sha256": "0ce63d11ecd311d5bb940d2e4c703f4530dd43a5b0e58d9582887c1faaf9f354", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-12", "text": "请读出心电图和血常规。", "category": "term", "text_sha256": "f30abfda01f613d922323b904b13eecb73e8113f413ae45bc90fcd314038f6cc", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
{"script_id": "tts-dev-13", "text": "银行的行长重新检查了记录。", "category": "polyphone", "text_sha256": "8e3fcbf5d315b2c50f1862f3796b27f93c17de5f9d43822ced777d69be3987f5", "sentence_count": 1, "split": "DEVELOPMENT_ONLY", "source_kind": "AUTHORED_SYNTHETIC_ENGINEERING_SCRIPT", "human_pronunciation_review": "PENDING", "clinical_use": "NOT_PATIENT_DATA_NOT_APPROVED_CLINICAL_ANSWER"}
